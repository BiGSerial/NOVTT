{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DiceRollResolved",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "campaign_id",
    "session_id",
    "roll_id",
    "actor_id",
    "dice",
    "occurred_at"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "const": "dice.roll.resolved"
    },
    "schema_version": {
      "const": 1
    },
    "campaign_id": {
      "type": "string",
      "format": "uuid"
    },
    "session_id": {
      "type": "string",
      "format": "uuid"
    },
    "roll_id": {
      "type": "string",
      "format": "uuid"
    },
    "actor_id": {
      "type": "string",
      "format": "uuid"
    },
    "dice": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
