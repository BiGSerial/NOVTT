    },
    {
      "id": "social_xp",
      "phase": "advancement",
      "budget": "xp",
      "targets": [
        "/attributes/social/*"
      ],
      "model": {
        "type": "current_rating_multiplier",
        "multiplier": 4
      }
    },
    {
      "id": "mental_xp",
