        "op": "multiply",
        "args": [
          {
            "ref": "/attributes/physical/forca"
          },
          {
            "const": 5
          }
        ]
      }
    }
  ],
  "effects": [
    {
      "id": "equipped_initiative",
      "target": "initiative",
      "mode": "add",
      "label": "Objeto em uso",
      "source": {
        "collection": "/inventory",
        "where": {
          "item": "equipped"
        }
      },
      "value": {
        "item": "initiative_bonus"
      },
      "stack_group": "trinkets",
      "stacking": "highest",
      "duration": {
        "unit": "permanent"
      }
    },
    {
      "id": "mist_initiative",
      "target": "initiative",
      "mode": "add",
      "label": "Dom: sussurro",
      "when": {
        "op": "compare",
        "args": [
          {
            "ref": "/origin/gift"
          },
          {
            "const": "sussurro"
          }
        ],
        "cmp": "eq"
      },
      "value": {
        "const": 1
      }
    }
  ],
  "constraints": [
    {
      "id": "distinct_priorities",
      "phase": "creation",
      "paths": [
        "/priorities/physical",
        "/priorities/social",
        "/priorities/mental"
      ],
      "label": "Cada prioridade uma vez",
      "assert": {
        "op": "or",
        "args": [
          {
            "op": "or",
            "args": [
              {
                "op": "compare",
                "args": [
                  {
                    "ref": "/priorities/physical"
                  },
                  {
                    "const": ""
                  }
                ],
                "cmp": "eq"
              },
              {
                "op": "compare",
                "args": [
                  {
                    "ref": "/priorities/social"
                  },
                  {
                    "const": ""
                  }
                ],
                "cmp": "eq"
              },
              {
                "op": "compare",
                "args": [
                  {
                    "ref": "/priorities/mental"
                  },
                  {
                    "const": ""
                  }
                ],
                "cmp": "eq"
              }
            ]
          },
          {
            "op": "and",
            "args": [
              {
                "op": "compare",
                "args": [
                  {
                    "ref": "/priorities/physical"
                  },
                  {
                    "ref": "/priorities/social"
                  }
                ],
                "cmp": "ne"
              },
              {
                "op": "compare",
                "args": [
                  {
                    "ref": "/priorities/physical"
                  },
                  {
                    "ref": "/priorities/mental"
                  }
                ],
                "cmp": "ne"
              },
              {
                "op": "compare",
                "args": [
                  {
                    "ref": "/priorities/social"
                  },
                  {
                    "ref": "/priorities/mental"
                  }
                ],
                "cmp": "ne"
              }
            ]
          }
        ]
      }
    }
  ],
  "creation": {
    "steps": [
      {
        "id": "identity",
        "label": "Identidade",
        "paths": [
          "/identity/*"
        ],
        "required": [
          "/identity/name"
        ]
      },
      {
        "id": "origin",
        "label": "Origem",
        "paths": [
          "/origin/*"
        ],
        "required": [
          "/origin/lineage",
          "/origin/gift"
        ]
      },
      {
        "id": "attributes",
        "label": "Atributos e habilidades",
        "paths": [
          "/priorities/*",
          "/attributes/physical/*",
          "/attributes/social/*",
          "/attributes/mental/*",
          "/skills/*"
        ],
        "required": [
          "/priorities/physical",
          "/priorities/social",
          "/priorities/mental"
        ],
        "complete_when": {
          "op": "and",
          "args": [
            {
              "op": "compare",
              "args": [
                {
                  "budget": "physical",
                  "of": "balance"
                },
                {
                  "const": 0
                }
              ],
              "cmp": "eq"
            },
            {
              "op": "compare",
              "args": [
                {
                  "budget": "social",
                  "of": "balance"
                },
                {
                  "const": 0
                }
              ],
              "cmp": "eq"
            },
            {
              "op": "compare",
              "args": [
                {
                  "budget": "mental",
                  "of": "balance"
                },
                {
                  "const": 0
                }
              ],
              "cmp": "eq"
            },
            {
              "op": "compare",
              "args": [
                {
                  "budget": "skill_points",
                  "of": "balance"
                },
                {
                  "const": 0
                }
              ],
              "cmp": "eq"
            }
          ]
        }
      },
      {
        "id": "review",
        "label": "Revisão",
        "paths": [
          "/resources/*"
        ],
        "complete_when": {
          "const": true
        }
      }
