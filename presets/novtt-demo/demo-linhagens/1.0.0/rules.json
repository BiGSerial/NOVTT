      "budget": "xp",
      "targets": [
        "/attributes/mental/*"
      ],
      "model": {
        "type": "current_rating_multiplier",
        "multiplier": 4
      }
    },
    {
      "id": "skill_xp",
      "phase": "advancement",
      "budget": "xp",
      "targets": [
        "/skills/*"
      ],
      "model": {
        "type": "formula",
        "formula": {
          "op": "if",
          "args": [
            {
              "op": "compare",
              "args": [
                {
                  "var": "current"
                },
                {
                  "const": 0
                }
              ],
              "cmp": "eq"
            },
            {
              "const": 3
            },
            {
              "op": "multiply",
              "args": [
                {
                  "var": "current"
                },
                {
                  "const": 2
                }
              ]
            }
          ]
        }
      }
    }
