{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "novtt-mesa 1.0.0 sheet",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 120
        },
        "concept": {
          "type": "string",
          "maxLength": 200
        },
        "motivation": {
          "type": "string",
          "maxLength": 300
        },
        "fear": {
          "type": "string",
          "maxLength": 300
        },
        "bonds": {
          "type": "string",
          "maxLength": 300
        }
      }
    },
    "attributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vigor": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "default": 1
        },
        "agilidade": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "default": 1
        },
        "astucia": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "default": 1
        },
        "presenca": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "default": 1
        }
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "atletismo": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "default": 0
        },
        "furtividade": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "default": 0
        },
        "investigacao": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "default": 0
        },
        "persuasao": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "default": 0
        },
        "luta": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "default": 0
        },
        "pontaria": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "default": 0
        },
        "saber": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "default": 0
        },
        "sobrevivencia": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "default": 0
        }
      }
    },
    "gear": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hook": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "master": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "notes": {
          "type": "string",
          "maxLength": 2000
        }
      }
    }
  }
}
