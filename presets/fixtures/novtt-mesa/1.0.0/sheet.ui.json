      "elements": [
        {
          "kind": "field",
          "path": "/skills/atletismo",
          "label": "Atletismo",
          "widget": "dot_rating"
        },
        {
          "kind": "field",
          "path": "/skills/furtividade",
          "label": "Furtividade",
          "widget": "dot_rating"
