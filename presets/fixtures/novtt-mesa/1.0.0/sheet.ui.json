{
  "contract": "novtt.sheet-ui/1",
  "default_access": "read_only",
  "sections": [
    {
      "id": "identity",
      "label": "Identidade",
      "elements": [
        {
          "kind": "field",
          "path": "/identity/name",
          "label": "Nome",
          "widget": "text",
          "access": "editable"
        },
        {
          "kind": "field",
          "path": "/identity/concept",
          "label": "Conceito",
          "widget": "text",
          "access": "editable"
        },
        {
          "kind": "field",
