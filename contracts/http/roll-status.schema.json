{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OfficialRollStatus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "idempotency_key",
    "status",
    "request_id",
    "revision",
    "session_sequence",
    "successes"
  ],
  "properties": {
    "idempotency_key": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "enum": [
        "pending",
        "completed",
        "rejected"
      ]
    },
    "roll_id": {
      "type": "string",
      "format": "uuid"
    },
    "dice": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "error_code": {
      "type": "string"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "session_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "successes": {
      "type": "integer",
      "minimum": 0
    }
  }
}
