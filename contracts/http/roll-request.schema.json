{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RollRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "session_id",
    "character_id",
    "idempotency_key",
    "pool"
  ],
  "properties": {
    "session_id": {
      "type": "string",
      "format": "uuid"
    },
    "character_id": {
      "type": "string",
      "format": "uuid"
    },
    "idempotency_key": {
      "type": "string",
      "format": "uuid"
    },
    "pool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "faces",
        "threshold"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "faces": {
          "type": "integer",
          "minimum": 2,
          "maximum": 1000
        },
        "threshold": {
          "type": "integer",
          "minimum": 1
        },
        "successes_per_die": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      }
    }
  }
}
