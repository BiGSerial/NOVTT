{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "demo-linhagens 1.0.0 sheet",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 120
        },
        "concept": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lineage": {
          "type": "string",
          "enum": [
            "aurora",
            "brasa",
            "nevoa"
          ]
        },
        "gift": {
          "type": "string",
          "enum": [
            "voo_curto",
            "pele_de_pedra",
            "sussurro"
          ]
        }
      }
    },
    "priorities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "physical": {
          "type": "string",
          "enum": [
            "primary",
            "secondary",
            "tertiary"
          ]
        },
        "social": {
          "type": "string",
          "enum": [
            "primary",
            "secondary",
            "tertiary"
          ]
        },
        "mental": {
          "type": "string",
          "enum": [
            "primary",
            "secondary",
            "tertiary"
          ]
        }
      }
    },
    "attributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "physical": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "forca": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5,
              "default": 1
            },
            "destreza": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5,
              "default": 1
            },
            "vigor": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5,
              "default": 1
            }
          }
        },
        "social": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "carisma": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5,
              "default": 1
            },
            "manipulacao": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5,
              "default": 1
            },
            "aparencia": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5,
              "default": 1
            }
          }
        },
        "mental": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "percepcao": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5,
              "default": 1
            },
            "inteligencia": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5,
              "default": 1
            },
            "raciocinio": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5,
              "default": 1
            }
          }
        }
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "luta": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "default": 0
        },
        "furtividade": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "default": 0
        },
        "erudicao": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "default": 0
        },
        "persuasao": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "default": 0
        },
        "oficio": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "default": 0
        }
      }
    },
    "derived": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vitality": {
          "type": "integer"
        },
        "initiative": {
          "type": "integer"
        },
        "load_capacity": {
          "type": "integer"
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vitality_current": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20,
          "default": 0
        },
        "resolve": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "default": 3
        }
      }
    },
    "inventory": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "weight": {
            "type": "integer",
            "minimum": 0,
            "maximum": 50,
            "default": 1
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99,
            "default": 1
          },
          "equipped": {
            "type": "boolean",
            "default": false
          },
          "initiative_bonus": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3,
            "default": 0
          }
        }
      }
    },
    "notes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "secret": {
          "type": "string",
          "maxLength": 1000
        }
      }
    }
  }
}
