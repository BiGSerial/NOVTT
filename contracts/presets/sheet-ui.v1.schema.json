{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:novtt:contract:sheet-ui:1",
  "title": "novtt.sheet-ui/1",
  "description": "Presentation and per-field access of a sheet. Every path MUST exist in the version's sheet.schema.json; paths starting with /_ are reserved for the engine. A collection path targets an array of objects, each with a unique string `id`; item fields never include `id`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "default_access",
    "sections"
  ],
  "properties": {
    "contract": {
      "const": "novtt.sheet-ui/1"
    },
    "default_access": {
      "$ref": "#/$defs/access"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/section"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "pointer": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^(/([^/~_]|~[01])([^/~]|~[01])*)+$"
    },
    "access": {
      "enum": [
        "hidden",
        "read_only",
        "editable",
        "approval_required",
        "master_only"
      ]
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "elements"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "access": {
          "$ref": "#/$defs/access"
        },
        "elements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/element"
          }
        }
      }
    },
    "element": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "path",
            "label",
            "widget"
          ],
          "properties": {
            "kind": {
              "const": "field"
            },
            "path": {
              "$ref": "#/$defs/pointer"
            },
            "label": {
              "$ref": "#/$defs/label"
            },
            "widget": {
              "$ref": "#/$defs/widget"
            },
            "access": {
              "$ref": "#/$defs/access"
            },
            "description": {
              "type": "string",
              "maxLength": 300
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "path",
            "label",
            "item_fields"
          ],
          "properties": {
            "kind": {
              "const": "collection"
            },
            "path": {
              "$ref": "#/$defs/pointer"
            },
            "label": {
              "$ref": "#/$defs/label"
            },
            "access": {
              "$ref": "#/$defs/access"
            },
            "max_items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            },
            "item_fields": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "field",
                  "label",
                  "widget"
                ],
                "properties": {
                  "field": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                  },
                  "label": {
                    "$ref": "#/$defs/label"
                  },
                  "widget": {
                    "$ref": "#/$defs/widget"
                  },
                  "access": {
                    "$ref": "#/$defs/access"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "widget": {
      "enum": [
        "text",
        "textarea",
        "integer",
        "number",
        "boolean",
        "dot_rating",
        "select"
      ]
    }
  }
}
