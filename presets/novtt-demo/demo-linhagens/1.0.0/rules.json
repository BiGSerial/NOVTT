            "requires": {
              "op": "compare",
              "args": [
                {
                  "ref": "/origin/lineage"
                },
                {
                  "const": "brasa"
                }
              ],
              "cmp": "eq"
            }
          },
          {
            "value": "sussurro",
            "label": "Sussurro",
            "compendium_id": "gift.sussurro"
          }
        ]
      }
    ]
