    "choices": [
      {
        "id": "lineage",
        "path": "/origin/lineage",
        "label": "Linhagem",
        "options": [
          {
            "value": "aurora",
            "label": "Aurora",
            "compendium_id": "lineage.aurora"
          },
          {
            "value": "brasa",
            "label": "Brasa",
            "compendium_id": "lineage.brasa"
          },
          {
            "value": "nevoa",
            "label": "Névoa",
            "compendium_id": "lineage.nevoa"
          }
        ]
      },
