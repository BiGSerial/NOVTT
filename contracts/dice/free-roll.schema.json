{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LocalFreeDiceRoll",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "origin",
    "expression",
    "dice",
    "created_at"
  ],
  "properties": {
    "origin": {
      "const": "local_unofficial"
    },
    "expression": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "dice": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "maxItems": 100
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
