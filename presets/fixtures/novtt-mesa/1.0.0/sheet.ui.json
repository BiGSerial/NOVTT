        {
          "kind": "field",
          "path": "/skills/saber",
          "label": "Saber",
          "widget": "dot_rating"
        },
        {
          "kind": "field",
          "path": "/skills/sobrevivencia",
          "label": "Sobrevivência",
          "widget": "dot_rating"
