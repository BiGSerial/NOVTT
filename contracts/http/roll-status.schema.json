{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OfficialRollStatus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "idempotency_key",
    "status",
    "request_id",
    "revision"
  ],
  "properties": {
    "idempotency_key": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "enum": [
        "pending",
        "completed",
        "rejected"
      ]
    },
    "roll_id": {
      "type": "string",
      "format": "uuid"
    },
    "dice": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "minItems": 1
    },
    "error_code": {
      "type": "string"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "session_sequence": {
      "type": "integer",
      "minimum": 1
    },
    "successes": {
      "type": "integer",
      "minimum": 0
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "roll_id",
          "dice",
          "successes",
          "session_sequence"
        ],
        "properties": {
          "error_code": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "pending"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "roll_id": false,
          "dice": false,
          "successes": false,
          "session_sequence": false,
          "error_code": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "rejected"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "error_code"
        ],
        "properties": {
          "roll_id": false,
          "dice": false,
          "successes": false,
          "session_sequence": false
        }
      }
    }
  ]
}
